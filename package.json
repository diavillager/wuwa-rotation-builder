    "test": "vitest run",
    "character-sync": "tsx scripts/character-sync/cli.ts",
    "characters:validate": "tsx scripts/character-sync/cli.ts --validate"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.0.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
